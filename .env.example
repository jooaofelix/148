# Public site URL used for metadata, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://148.com.br

# Google Analytics 4 measurement ID (leave empty to disable).
NEXT_PUBLIC_GA_ID=

# Meta (Facebook/Instagram) Pixel ID (leave empty to disable).
NEXT_PUBLIC_META_PIXEL_ID=

# Required to access /admin. Use long, random values in production.
ADMIN_PASSWORD=
ADMIN_SECRET=
